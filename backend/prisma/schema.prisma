generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String    @id @default(uuid()) @db.Uuid
  email      String    @unique
  password   String
  name       String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  isApproved           Boolean   @default(false) @map("is_approved")
  role                 Role      @default(USER)
  resetPasswordToken   String?   @map("reset_password_token")
  resetPasswordExpires DateTime? @map("reset_password_expires")
  comments             Comment[]

  @@map("users")
}

model Article {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique
  title       String
  content     String?
  excerpt     String?
  category    String
  type        String?   @default("ACRC Commentaries")
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  pdfUrl      String?   @map("pdf_url")
  author      String?
  publishedAt DateTime? @map("published_at")
  comments    Comment[]

  @@map("articles")
}

model Comment {
  id         String    @id @default(uuid()) @db.Uuid
  content    String
  articleId  String    @map("article_id") @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  parentId   String?   @map("parent_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  authorName String?   @map("author_name")
  article    Article   @relation(fields: [articleId], references: [id])
  parent     Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies    Comment[] @relation("CommentReplies")
  user       User?     @relation(fields: [userId], references: [id])

  @@map("comments")
}

model ContactInquiry {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String
  subject      String?
  message      String
  createdAt    DateTime @default(now()) @map("created_at")
  phone        String?
  organization String?
  inquiryType  String?  @map("inquiry_type")

  @@map("contact_inquiries")
}

model CareerApplication {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  email      String
  phone      String
  role       String
  message    String?
  cvPath     String   @map("cv_path") 
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("career_applications")
}

enum Role {
  USER
  ADMIN
}

model TeamMember {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  titleEn    String   @map("title_en")
  titleId    String   @map("title_id")
  shortBioEn String?  @map("short_bio_en")
  shortBioId String?  @map("short_bio_id")
  bioEn      String   @map("bio_en")
  bioId      String   @map("bio_id")
  photoUrl   String?  @map("photo_url")
  type       String   @default("ASSOCIATE") // 'CEO', 'ASSOCIATE', 'ADVISORY_BOARD'
  order      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("team_members")
}

model SiteSetting {
  key   String @id
  value String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model JobOpening {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  type        String?  // e.g. Full-time, Part-time, Internship
  location    String?
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("job_openings")
}
